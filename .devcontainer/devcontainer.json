// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3 with Ollama",
	// Use Docker Compose to run multiple services
	"dockerComposeFile": "../docker-compose.yml",
	"service": "flask-app",
	"workspaceFolder": "/app",
	
	"features": {
		"ghcr.io/devcontainers-extra/features/uv:1": {}
	},

	// Forward ports for Flask and Ollama
	"forwardPorts": [5000, 11434],

	// Install dependencies after container is created
	"postCreateCommand": "uv add -r requirements.txt",

	// Configure tool-specific properties
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance"
			]
		}
	}
}
